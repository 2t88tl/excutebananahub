-- ========== TELEPORT VÀO GIỮA VƯỜN ==========
local function TeleportToGardenCenter()
    local plantAreas = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:find("PlantArea") or obj:FindFirstChild("PlantArea")) then
            table.insert(plantAreas, obj)
        end
    end
    
    if #plantAreas > 0 then
        local totalX, totalZ = 0, 0
        for _, area in pairs(plantAreas) do
            local pos = area.Position
            totalX = totalX + pos.X
            totalZ = totalZ + pos.Z
        end
        local center = Vector3.new(totalX / #plantAreas, plantAreas[1].Position.Y + 3, totalZ / #plantAreas)
        LocalPlayer.Character:SetPrimaryPartCFrame(CFrame.new(center))
        CurrentAction = "Teleported to garden"
        LastAction = "Teleported to center"
    else
        warn("Không tìm thấy PlantArea")
    end
end

-- ========== LOCK VỊ TRÍ (chống cướp) ==========
local function LockPlayerPosition()
    if not Config.LockPosition then return end
    local character = LocalPlayer.Character
    if not character then return end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local bodyPosition = Instance.new("BodyPosition")
    bodyPosition.MaxForce = Vector3.new(4000, 4000, 4000)
    bodyPosition.D = 500
    bodyPosition.P = 2000
    bodyPosition.Position = humanoidRootPart.Position
    bodyPosition.Parent = humanoidRootPart
    
    PlayerPositionLock = bodyPosition
    
    -- Cập nhật vị trí mỗi 0.2 giây
    task.spawn(function()
        while IsFarming and PlayerPositionLock do
            task.wait(0.2)
            if humanoidRootPart and humanoidRootPart.Parent then
                PlayerPositionLock.Position = humanoidRootPart.Position
            else
                break
            end
        end
    end)
end

-- ========== AUTO HARVEST ==========
local function AutoHarvest()
    local harvestPrompts = {}
    for _, prompt in pairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and (prompt.Name:find("Harvest") or prompt.Name:find("Collect")) then
            -- Tính giá trị bán nếu có
            local sellValue = 0
            local parent = prompt.Parent
            if parent then
                local val = parent:FindFirstChild("SellValue") or parent:FindFirstChild("Value")
                if val then
                    sellValue = tonumber(val.Value) or 0
                end
            end
            table.insert(harvestPrompts, {prompt = prompt, value = sellValue})
        end
    end
    
    -- Sắp xếp theo giá trị cao nhất trước
    table.sort(harvestPrompts, function(a, b) return a.value > b.value end)
    
    for _, data in pairs(harvestPrompts) do
        local success, err = pcall(function()
            data.prompt:PromptButtonHoldBegan(data.prompt.RequiresLineOfSight)
            task.wait(0.1)
            data.prompt:PromptButtonHoldEnded()
        end)
        if success then
            TotalHarvested = TotalHarvested + 1
            CurrentAction = "Harvesting"
            LastAction = "Harvested plant (value: " .. data.value .. ")"
            break
        end
    end
end

-- ========== AUTO PLANT ==========
local function AutoPlant()
    -- Tìm đất trống
    local emptyPlots = {}
    for _, plot in pairs(workspace:GetDescendants()) do
        if plot:IsA("BasePart") and (plot.Name:find("Plot") or plot.Name:find("Soil")) then
            local hasPlant = false
            for _, child in pairs(plot:GetChildren()) do
                if child:IsA("BasePart") and (child.Name:find("Plant") or child:FindFirstChild("Plant")) then
                    hasPlant = true
                    break
                end
            end
            if not hasPlant then
                table.insert(emptyPlots, plot)
            end
        end
    end
    
    if #emptyPlots > 0 then
        local plot = emptyPlots[math.random(1, #emptyPlots)]
        -- Lấy seed từ backpack
        local seeds = {}
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name:find("Seed") or item:FindFirstChild("IsSeed")) then
                table.insert(seeds, item)
            end
        end
        if #seeds > 0 then
            local seed = seeds[1]
            -- Random jitter
            local jitter = Vector3.new(
                (math.random() - 0.5) * 2,
                0,
                (math.random() - 0.5) * 2
            )
            local plantPos = plot.Position + Vector3.new(0, 2, 0) + jitter
            -- Equip và plant
            seed.Parent = LocalPlayer.Character
            task.wait(0.1)
            -- Fire remote plant nếu có
            local plantRemote = FindRemote("PlantSeed")
            if plantRemote then
                plantRemote:FireServer(seed, plantPos)
            end
            CurrentAction = "Planting"
            LastAction = "Planted " .. seed.Name
        end
    end
end

-- ========== AUTO SELL ==========
local function AutoSell()
    local itemsToSell = {}
    -- Check backpack
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and (item:FindFirstChild("SellValue") or item.Name:find("Fruit") or item.Name:find("Crop")) then
            table.insert(itemsToSell, item)
        end
    end
    -- Check character
    if LocalPlayer.Character then
        for _, item in pairs(LocalPlayer.Character:GetChildren()) do
            if item:IsA("Tool") and (item:FindFirstChild("SellValue") or item.Name:find("Fruit") or item.Name:find("Crop")) then
                table.insert(itemsToSell, item)
            end
        end
    end
    
    for _, item in pairs(itemsToSell) do
        if SellRemote then
            SellRemote:FireServer(item)
            CurrentAction = "Selling"
            LastAction = "Sold " .. item.Name
            task.wait(0.2)
        end
    end
end

-- ========== AUTO BUY SEED ==========
local function AutoBuySeed()
    local seedShop = workspace:FindFirstChild("SeedShop") or workspace:FindFirstChild("Shop")
    if not seedShop then return end
    
    -- Seed ưu tiên rẻ -> đắt
    local seedPriority = {"CarrotSeed", "PotatoSeed", "TomatoSeed", "PumpkinSeed", "MelonSeed", "WatermelonSeed"}
    
    for _, seedName in pairs(seedPriority) do
        local seed = seedShop:FindFirstChild(seedName)
        if seed and seed:IsA("Tool") then
            if BuyRemote then
                BuyRemote:FireServer(seed)
                TotalSeedsBought = TotalSeedsBought + 1
                CurrentAction = "Buying seed"
                LastAction = "Bought " .. seedName
                break
            end
        end
    end
end

