-- ========== CẤU HÌNH ==========
local Config = {
    HarvestDelay = 0.5,      -- giây giữa mỗi lần harvest
    PlantDelay = 0.8,        -- giây giữa mỗi lần plant
    SellDelay = 1,           -- giây giữa mỗi lần sell
    BuySeedDelay = 2,        -- giây giữa mỗi lần mua seed
    LockPosition = true,     -- lock vị trí khỏi bị cướp
}

-- ========== BIẾN TOÀN CỤC ==========
local TotalHarvested = 0
local TotalSeedsBought = 0
local LastAction = "Waiting..."
local CurrentAction = "Idle"
local IsFarming = true

-- Cache để giảm lag
local cachedHarvestPrompts = {}
local cachedPlants = {}
local cachedPlots = {}
local lastHarvestScan = 0
local lastPlantScan = 0
local lastSellScan = 0
local lastGearScan = 0

-- ========== TÌM REMOTE ==========
local function FindRemote(remoteName)
    local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    if remotes and remotes:FindFirstChild(remoteName) then
        return remotes[remoteName]
    end
    return game:GetService("ReplicatedStorage"):FindFirstChild(remoteName)
end

local SellRemote = FindRemote("SellItem") or FindRemote("SellAll")
local BuyRemote = FindRemote("BuySeed") or FindRemote("PurchaseSeed")

-- ========== AUTO HARVEST (có cache) ==========
local function AutoHarvest()
    local now = tick()
    if now - lastHarvestScan > 2 then
        cachedHarvestPrompts = {}
        for _, prompt in pairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                local sellValue = 0
                local parent = prompt.Parent
                if parent then
                    local val = parent:FindFirstChild("SellValue") or parent:FindFirstChild("Value")
                    if val then sellValue = tonumber(val.Value) or 0 end
                end
                table.insert(cachedHarvestPrompts, {prompt = prompt, value = sellValue})
            end
        end
        table.sort(cachedHarvestPrompts, function(a, b) return a.value > b.value end)
        lastHarvestScan = now
    end
    
    for _, data in pairs(cachedHarvestPrompts) do
        local success = pcall(function()
            data.prompt:PromptButtonHoldBegan(data.prompt.RequiresLineOfSight)
            task.wait(0.1)
            data.prompt:PromptButtonHoldEnded()
        end)
        if success then
            TotalHarvested = TotalHarvested + 1
            CurrentAction = "Harvesting"
            LastAction = "Harvested plant"
            break
        end
    end
end

-- ========== AUTO PLANT (có cache) ==========
local function AutoPlant()
    local now = tick()
    if now - lastPlantScan > 3 then
        cachedPlots = {}
        for _, plot in pairs(workspace:GetDescendants()) do
            if plot:IsA("BasePart") and (plot.Name:find("Plot") or plot.Name:find("Soil") or plot.Name:find("Land")) then
                local hasPlant = false
                for _, child in pairs(plot:GetChildren()) do
                    if child:IsA("BasePart") and (child.Name:find("Plant") or child:FindFirstChild("Plant")) then
                        hasPlant = true
                        break
                    end
                end
                if not hasPlant then
                    table.insert(cachedPlots, plot)
                end
            end
        end
        lastPlantScan = now
    end
    
    if #cachedPlots > 0 then
        local plot = cachedPlots[math.random(1, #cachedPlots)]
        local seeds = {}
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name:find("Seed") or item.Name:find("seed")) then
                table.insert(seeds, item)
            end
        end
        if #seeds > 0 then
            local seed = seeds[1]
            seed.Parent = LocalPlayer.Character
            task.wait(0.2)
            CurrentAction = "Planting"
            LastAction = "Planted " .. seed.Name
        end
    end
end

-- ========== AUTO SELL (có cache) ==========
local function AutoSell()
    local now = tick()
    if now - lastSellScan < 1.5 then return end
    lastSellScan = now
    
    local itemsToSell = {}
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and (item:FindFirstChild("SellValue") or item.Name:find("Fruit") or item.Name:find("Crop")) then
            table.insert(itemsToSell, item)
        end
    end
    
    for _, item in pairs(itemsToSell) do
        if SellRemote then
            pcall(function() SellRemote:FireServer(item) end)
            CurrentAction = "Selling"
            LastAction = "Sold " .. item.Name
            task.wait(0.3)
        end
    end
end

-- ========== AUTO BUY SEED ==========
local function AutoBuySeed()
    local seedShop = workspace:FindFirstChild("Shop") or workspace:FindFirstChild("Market") or workspace:FindFirstChild("SeedShop")
    if not seedShop then return end
    
    local seedPriority = {"CarrotSeed", "PotatoSeed", "TomatoSeed", "PumpkinSeed", "MelonSeed", "WatermelonSeed"}
    
    for _, seedName in pairs(seedPriority) do
        local seed = seedShop:FindFirstChild(seedName)
        if seed and seed:IsA("Tool") and BuyRemote then
            pcall(function() BuyRemote:FireServer(seed) end)
            TotalSeedsBought = TotalSeedsBought + 1
            CurrentAction = "Buying seed"
            LastAction = "Bought " .. seedName
            break
        end
    end
end

-- ========== AUTO GEAR (Sprinkler + Watering Can) - gọn nhẹ ==========
local lastSprinklerTime = 0
local lastWateringTime = 0

local function GetTopPlants(n)
    local plants = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:find("Plant") or obj:FindFirstChild("IsPlant")) then
            local value = 0
            local val = obj:FindFirstChild("SellValue") or obj:FindFirstChild("Value")
            if val then value = tonumber(val.Value) or 0 end
            table.insert(plants, {obj = obj, value = value})
        end
    end
    table.sort(plants, function(a, b) return a.value > b.value end)
    local top = {}
    for i = 1, math.min(n, #plants) do
        table.insert(top, plants[i].obj)
    end
    return top
end

local function AutoUseGear()
    local now = tick()
    
    if now - lastSprinklerTime >= 30 then
        local topPlants = GetTopPlants(1)
        if #topPlants > 0 then
            local sprinkler = LocalPlayer.Backpack:FindFirstChild("Sprinkler")
            if sprinkler then
                sprinkler.Parent = LocalPlayer.Character
                task.wait(0.1)
                lastSprinklerTime = now
                CurrentAction = "Using Sprinkler"
                LastAction = "Placed sprinkler"
            end
        end
    end
    
    if now - lastWateringTime >= 5 then
        local topPlants = GetTopPlants(5)
        local wateringCan = LocalPlayer.Backpack:FindFirstChild("WateringCan")
        if wateringCan and #topPlants > 0 then
            wateringCan.Parent = LocalPlayer.Character
            task.wait(0.1)
            lastWateringTime = now
            CurrentAction = "Watering"
            LastAction = "Watered plants"
        end
    end
end

