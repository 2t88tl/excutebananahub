-- ========== 1. AUTO GEAR (Sprinkler + Watering Can) ==========
local function GetTopPlants(n)
    local plants = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:find("Plant") or obj:FindFirstChild("IsPlant")) then
            local value = 0
            local val = obj:FindFirstChild("SellValue") or obj:FindFirstChild("Value")
            if val then value = tonumber(val.Value) or 0 end
            table.insert(plants, {obj = obj, value = value})
        end
    end
    table.sort(plants, function(a, b) return a.value > b.value end)
    local top = {}
    for i = 1, math.min(n, #plants) do
        table.insert(top, plants[i].obj)
    end
    return top
end

local function AutoUseGear()
    local now = tick()
    
    -- Sprinkler (30s cooldown)
    if now - lastSprinklerTime >= 30 then
        local topPlants = GetTopPlants(1)
        if #topPlants > 0 then
            local sprinkler = LocalPlayer.Backpack:FindFirstChild("Sprinkler") or LocalPlayer.Character:FindFirstChild("Sprinkler")
            if sprinkler then
                sprinkler.Parent = LocalPlayer.Character
                task.wait(0.1)
                local useRemote = FindRemote("UseGear")
                if useRemote then
                    useRemote:FireServer(sprinkler, topPlants[1].Position)
                    lastSprinklerTime = now
                    CurrentAction = "Using Sprinkler"
                    LastAction = "Placed sprinkler on top plant"
                end
            end
        end
    end
    
    -- Watering Can (5s cooldown, top 5 plants)
    if now - lastWateringTime >= 5 then
        local topPlants = GetTopPlants(5)
        local wateringCan = LocalPlayer.Backpack:FindFirstChild("WateringCan") or LocalPlayer.Character:FindFirstChild("WateringCan")
        if wateringCan and #topPlants > 0 then
            wateringCan.Parent = LocalPlayer.Character
            task.wait(0.1)
            local useRemote = FindRemote("UseGear")
            for _, plant in pairs(topPlants) do
                if useRemote then
                    useRemote:FireServer(wateringCan, plant.Position)
                    task.wait(0.1)
                end
            end
            lastWateringTime = now
            CurrentAction = "Watering"
            LastAction = "Watered " .. #topPlants .. " plants"
        end
    end
end

-- ========== 2. AUTO SHOVEL WEAK PLANTS ==========
local function GetBestSeedValue()
    local bestValue = 0
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:find("Seed") or item:FindFirstChild("IsSeed")) then
            local val = item:FindFirstChild("SellValue") or item:FindFirstChild("Price")
            if val and tonumber(val.Value) then
                bestValue = math.max(bestValue, tonumber(val.Value))
            end
        end
    end
    return bestValue
end

local function AutoShovelWeakPlants()
    local now = tick()
    if now - lastShovelTime < 3 then return end
    
    local bestSeedValue = GetBestSeedValue()
    if bestSeedValue == 0 then return end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:find("Plant") or obj:FindFirstChild("IsPlant")) then
            local plantValue = 0
            local val = obj:FindFirstChild("SellValue") or obj:FindFirstChild("Value")
            if val then plantValue = tonumber(val.Value) or 0 end
            
            if plantValue < bestSeedValue * 0.5 then
                if ShovelRemote then
                    ShovelRemote:FireServer(obj)
                    lastShovelTime = now
                    CurrentAction = "Shoveling weak plant"
                    LastAction = "Shoveled plant (value " .. plantValue .. " < 50% of best seed)"
                    break
                end
            end
        end
    end
end

-- ========== 3. AUTO EXPAND GARDEN ==========
local function GetCurrentMoney()
    -- Tìm money value
    local money = LocalPlayer.leaderstats:FindFirstChild("Sheckles") or LocalPlayer.leaderstats:FindFirstChild("Money")
    if money then return money.Value end
    return 0
end

local function AutoExpandGarden()
    local now = tick()
    if now - lastExpandCheck < 10 then return end
    lastExpandCheck = now
    
    local money = GetCurrentMoney()
    local expandPrice = nil
    
    -- Tìm giá mở rộng tiếp theo
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name:find("Expand") or obj.Name:find("Expansion") then
            local price = obj:FindFirstChild("Price") or obj:FindFirstChild("Cost")
            if price and tonumber(price.Value) then
                if money >= tonumber(price.Value) then
                    expandPrice = tonumber(price.Value)
                    break
                end
            end
        end
    end
    
    if expandPrice and ExpandRemote then
        ExpandRemote:FireServer(expandPrice)
        CurrentAction = "Expanding garden"
        LastAction = "Bought expansion for " .. expandPrice
    end
end

-- ========== 4. AUTO EVENTS (Rainbow/Gold Seed, SeedPack) ==========
local collectedEvents = {} -- để tránh spam collect

local function AutoCollectEvents()
    local eventItems = {"RainbowSeed", "GoldSeed", "SeedPack", "MythicSeed"}
    
    for _, itemName in pairs(eventItems) do
        local items = workspace:GetDescendants()
        for _, item in pairs(items) do
            if item.Name == itemName and item:IsA("BasePart") and not collectedEvents[item] then
                -- Tìm prompt để collect
                local prompt = item:FindFirstChild("ProximityPrompt") or item.Parent:FindFirstChild("ProximityPrompt")
                if prompt and prompt:IsA("ProximityPrompt") then
                    pcall(function()
                        prompt:PromptButtonHoldBegan(false)
                        task.wait(0.1)
                        prompt:PromptButtonHoldEnded()
                        collectedEvents[item] = true
                        CurrentAction = "Collecting event"
                        LastAction = "Collected " .. itemName
                    end)
                end
            end
        end
    end
end

