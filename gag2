-- ========== 6. AUTO PETS ==========
local function GetPetPrice(pet)
    local price = pet:FindFirstChild("BasePrice") or pet:FindFirstChild("Price") or pet:FindFirstChild("Cost")
    if price then return tonumber(price.Value) or 999999 else return 999999 end
end

local function AutoBuyPets()
    local now = tick()
    if now - lastPetBuyTime < 5 then return end
    
    local money = GetCurrentMoney()
    local wildPets = {}
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name:find("Pet") or obj.Name:find("Animal") then
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local price = GetPetPrice(obj)
                if price <= money then
                    table.insert(wildPets, {obj = obj, price = price})
                end
            end
        end
    end
    
    -- Sắp xếp theo giá rẻ nhất trước
    table.sort(wildPets, function(a, b) return a.price < b.price end)
    
    if #wildPets > 0 and PetBuyRemote then
        PetBuyRemote:FireServer(wildPets[1].obj)
        lastPetBuyTime = now
        CurrentAction = "Buying pet"
        LastAction = "Tamed pet (price: " .. wildPets[1].price .. ")"
    end
end

local function AutoEquipPets()
    local pets = {}
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:find("Pet") or item:FindFirstChild("IsPet")) then
            local price = GetPetPrice(item)
            table.insert(pets, {item = item, price = price})
        end
    end
    
    table.sort(pets, function(a, b) return a.price > b.price end)
    
    if #pets > 0 and PetEquipRemote then
        PetEquipRemote:FireServer(pets[1].item)
        CurrentAction = "Equipping best pet"
        LastAction = "Equipped pet (price: " .. pets[1].price .. ")"
    end
end

local function AutoBuyPetSlots()
    local now = tick()
    if now - lastPetSlotCheck < 30 then return end
    lastPetSlotCheck = now
    
    local money = GetCurrentMoney()
    local slotPrices = {200000, 1000000, 5000000}
    
    for _, price in pairs(slotPrices) do
        if money >= price and PetSlotRemote then
            PetSlotRemote:FireServer(price)
            CurrentAction = "Buying pet slot"
            LastAction = "Bought pet slot for " .. price
            break
        end
    end
end

